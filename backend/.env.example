# Copy this file to .env (cp .env.example .env) and adjust if needed.
# Loaded at startup by commoneventframework's loadEnv().

# --- PostgreSQL (values match docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=vacation
DB_PASSWORD=vacation
DB_NAME=vacation_management

# --- Authentication ---
# Secret used to sign JWTs. Mandatory: there is no default value in the code.
# Use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=change-me-to-a-long-random-string

# --- commoneventframework ---
# Name used by CEF for AWS Parameter Store paths (Parameter Store stays disabled locally).
LAMBDA_NAME=vacation-management-api
